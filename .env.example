# Projeto Supabase do PetShop
SUPABASE_PROJECT_REF=ahoxobyduzludlgxtpsx
PETSHOP_SUPABASE_PROJECT_REF=ahoxobyduzludlgxtpsx
SUPABASE_URL=https://ahoxobyduzludlgxtpsx.supabase.co

# O MCP remoto do Codex usa OAuth salvo fora deste arquivo; nao requer token aqui.
# Token pessoal opcional: apenas para .mcp.json.example/run.ps1 (Claude Code)
# ou Management API. Nao e a senha do banco.
SUPABASE_ACCESS_TOKEN=

# O ETL atual nao usa chaves de API. Preencher apenas quando necessario.
# O escopo OAuth atual nao permite consultar as chaves pelo MCP.
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: uso exclusivo no servidor; nao disponibilizar no frontend.
SUPABASE_SECRET_KEY=

# Pendente: copie a URL de Connect > Session pooler (porta 5432), banco postgres.
# Usuario: postgres.ahoxobyduzludlgxtpsx. Confirme o host no painel.
# npm run deploy pode pedir a senha sem grava-la: omita a senha da URL.
# Vazio: executor Node usa conexao direta e solicita a senha no terminal.
# deploy.ps1 exige esta variavel preenchida.
DATABASE_URL=

# Dashboard: somente no servidor. A chave secreta acima consulta as views.
DEMO_USERNAME=márcio
DEMO_PASSWORD=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Opcionais: sem ambos, o assistente mostra estado indisponivel.
GROQ_API_KEY=
GROQ_MODEL=
