# ---------------------------------------------------------------------------
# Supabase MCP (usado pelo .mcp.json)
# ---------------------------------------------------------------------------

# Personal Access Token: https://supabase.com/dashboard/account/tokens
# Account Settings > Access Tokens > Generate new token  (aparece so uma vez)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Reference ID: https://supabase.com/dashboard/project/<REFERENCE_ID>
# ou Project Settings > General > Reference ID
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst

# ---------------------------------------------------------------------------
# Supabase client (opcional — so se o codigo for acessar o banco/API)
# ---------------------------------------------------------------------------

SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
